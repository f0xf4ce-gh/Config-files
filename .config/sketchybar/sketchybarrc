#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Darkthrone: transparent field, cold grey type, hard square geometry.
sketchybar --bar \
  position=top \
  height=34 \
  notch_display_height=34 \
  color=0x00000000 \
  shadow=off

sketchybar --default \
  icon.font="SF Pro:Semibold:13.0" \
  label.font="SF Pro:Regular:13.0" \
  icon.color=0xffc1c1c1 \
  label.color=0xffc1c1c1 \
  padding_left=4 \
  padding_right=4

sketchybar --add item apple left \
  --set apple \
    icon="" \
    icon.font="SF Pro:Regular:15.0" \
    icon.color=0xffc1c1c1 \
    label.drawing=off \
    padding_left=8 \
    padding_right=8

for sid in 1 2 3 4 5; do
  sketchybar --add space "space.$sid" left \
    --set "space.$sid" \
      icon="$sid" \
      label.drawing=off \
      background.drawing=on \
      background.color=0x00000000 \
      background.corner_radius=0 \
      background.height=24 \
      script="$PLUGIN_DIR/space.sh" \
      click_script="yabai -m space --focus $sid" \
    --subscribe "space.$sid" space_change
done

sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.font="SF Pro:Semibold:13.0" \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock \
    icon.drawing=off \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --update
