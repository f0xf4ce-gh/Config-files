#!/usr/bin/env sh

# SIP-safe yabai baseline: automatic BSP tiling, no scripting addition.
yabai -m config layout bsp
yabai -m config external_bar all:28:0
yabai -m config split_type auto
yabai -m config window_placement second_child
yabai -m config window_gap 8
yabai -m config top_padding 10
yabai -m config bottom_padding 12
yabai -m config left_padding 12
yabai -m config right_padding 12
yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off
yabai -m config window_animation_duration 0.0
yabai -m config auto_balance off

# macOS reports Ghostty's native tabs as temporary windows to yabai. Re-layout
# the BSP after tab changes so the phantom leaf does not keep half the space.
yabai -m signal --add app='^Ghostty$' event=window_created action='yabai -m space --layout bsp'
yabai -m signal --add app='^Ghostty$' event=window_destroyed action='yabai -m space --layout bsp'

echo "yabai configuration loaded"
